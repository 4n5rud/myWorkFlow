#!/usr/bin/env bash
# Global git hook dispatcher (claude-work-harness, 지침서 15). Installed as core.hooksPath for this user.
# Every hook name in this folder is a link to this file.
#  - read-only repos (READONLY_REPOS) and no-commit repos (NO_COMMIT_REPOS) in harness.conf: commits, merges,
#    reverts, cherry-picks, patches and pushes are refused. The repo is compared by its shared git folder, so
#    worktrees, git -C, --git-dir and GIT_DIR are all covered. prepare-commit-msg is checked too because a commit
#    that skips the other hooks still runs it.
#  - pre-commit:  scan what is about to be committed (index), then personal material in shared repos
#  - commit-msg:  scan the commit message, and refuse AI signatures
#  - pre-push:    scan the full history of every commit that the remote does not have yet, then submodule pointers
# Then the repository's own hook (.git/hooks/<name>, e.g. Git LFS, project secret guards) runs as before.
name="${0##*/}"
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
own="$common/hooks/$name"
run_own() { # chain to the repository's own hook, never to this dispatcher itself
  if [[ -n "$common" && -x "$own" && "$(cd "${own%/*}" && pwd -P)/$name" != "$(cd "${0%/*}" && pwd -P)/$name" ]]; then
    if [[ -n "${stdin_file:-}" ]]; then exec "$own" "$@" < "$stdin_file"; else exec "$own" "$@"; fi
  fi
  exit 0
}

case "$name" in
  pre-commit|prepare-commit-msg|commit-msg|pre-merge-commit|pre-rebase|pre-applypatch|applypatch-msg|pre-push) ;;
  *) run_own "$@" ;;   # nothing to check for this hook: only the repository's own hook, if any (no extra cost)
esac

SCAN="${SECRET_SCAN:-$HOME/.claude/hooks/secret-scan.sh}"
stdin_file=""
if [[ "$name" == pre-push ]]; then
  stdin_file=$(mktemp); cat > "$stdin_file"; trap 'rm -f "$stdin_file"' EXIT
fi

# read-only and no-commit repos
CONF="${HARNESS_CONF:-$HOME/.claude/harness.conf}"; READONLY_REPOS=(); NO_COMMIT_REPOS=()
[[ -f "$CONF" ]] && source "$CONF" 2>/dev/null
# git hands its hooks GIT_DIR and friends (in worktrees, submodules, commit <paths>). They must not leak into
# questions about another repo, or every repo looks like the listed one. The current repo's checks keep them.
git_other() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_PREFIX git "$@"; }
common_of() { git_other -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null; }
same_repo() { # $1=listed repo path
  local c; c=$(common_of "$1") || return 1
  [[ -n "$c" && -n "$common" ]] || return 1
  [[ "$c" == "$common" || "$(cd "$c" 2>/dev/null && pwd -P)" == "$(cd "$common" 2>/dev/null && pwd -P)" ]]
}
policy_block() {
  echo "" >&2
  echo "🔴 $1 (claude-work-harness, harness.conf)" >&2
  echo "   $2" >&2
  exit 1
}
if [[ -n "$common" ]]; then
  # pre-rebase only matters when it would rewrite commits that exist here only
  rebase_rewrites=1
  if [[ "$name" == pre-rebase ]]; then
    [[ -n "${1:-}" && -z "$(git rev-list -n1 "$1..${2:-HEAD}" 2>/dev/null)" ]] && rebase_rewrites=0
  fi
  if (( rebase_rewrites )); then
    for r in ${READONLY_REPOS[@]+"${READONLY_REPOS[@]}"}; do
      same_repo "$r" && policy_block "읽기 전용 저장소라서 막았습니다: ${r##*/}" \
        "이 저장소는 커밋, 머지, 되돌리기, 푸시를 하지 않습니다. 읽기는 괜찮습니다. 산출물은 프로젝트 폴더에 만드세요."
    done
    for r in ${NO_COMMIT_REPOS[@]+"${NO_COMMIT_REPOS[@]}"}; do
      same_repo "$r" && policy_block "커밋과 푸시를 하지 않는 저장소라서 막았습니다: ${r##*/}" \
        "파일은 고쳐도 되지만 커밋, 머지, 푸시는 하지 않습니다. 바뀐 내용은 사용자가 직접 반영합니다."
    done
  fi
fi

block() {
  echo "" >&2
  echo "🔴 비밀값으로 보이는 것이 있어서 ${1}을 막았습니다 (claude-work-harness, 지침서 15)." >&2
  echo "$2" | sed 's/^/   /' >&2
  echo "   값을 지우고 .env나 비밀 관리로 옮긴 뒤 다시 하세요. 이미 원격에 올라간 값이면 재발급하세요." >&2
  echo "   진짜 비밀값이 아니면 ~/.claude/harness/secret-allow.txt 에 해당 줄을 가리키는 정규식을 적습니다(사용자만)." >&2
  exit 1
}

case "$name" in
  pre-commit)
    if [[ -x "$SCAN" ]]; then out=$("$SCAN" staged .) || block "커밋" "$out"; fi
    PSCAN="${PERSONAL_SCAN:-$HOME/.claude/hooks/personal-scan.sh}"
    if [[ -x "$PSCAN" ]] && ! out=$("$PSCAN" .); then
      echo "" >&2
      echo "🔴 공용 저장소에 개인 자료가 들어가서 커밋을 막았습니다 (claude-work-harness, 지침서 12, 13, 14)." >&2
      echo "$out" | sed 's/^/   /' >&2
      echo "   절대 경로는 저장소 기준 상대 경로로, 개인 노트 위치는 빼고 내용만 적으세요. 할 일 목록과 발신함 목록은 커밋하지 않습니다." >&2
      exit 1
    fi ;;
  commit-msg)
    # AI signatures never go into a commit message (00 세션 공통 지침 §8). Comment lines are not part of the message.
    if grep -v '^#' "$1" | grep -qiE 'Co-Authored-By:.*(Claude|anthropic)|Generated with \[?Claude'; then
      echo "" >&2
      echo "🔴 커밋 메시지에 AI 서명이 있어서 커밋을 막았습니다 (claude-work-harness, 00 세션 공통 지침 §8)." >&2
      echo "   Co-Authored-By나 Generated with 줄을 빼고 다시 커밋하세요." >&2
      exit 1
    fi
    if [[ -x "$SCAN" ]]; then out=$("$SCAN" text < "$1") || block "커밋" "$out"; fi
    # 제목 규칙(지침서 09). Claude 세션의 커밋은 막고, 사람이 터미널에서 친 커밋은 경고만 한다.
    MCHK="${COMMIT_MSG_CHECK:-$HOME/.claude/hooks/commit-msg-check.sh}"
    # 검사기 자체가 고장 나면(종료 코드 1이 아님) 커밋을 막지 않는다
    rc=0; [[ -x "$MCHK" ]] && { out=$("$MCHK" "$1" 2>&1) || rc=$?; }
    if (( rc != 0 && rc != 1 )); then echo "⚠️  커밋 메시지 검사기가 실패해서 검사를 건너뜁니다(종료 코드 $rc)." >&2; out=""
    elif (( rc == 1 )); then
      if [[ -n "${CLAUDECODE:-}" ]]; then
        echo "" >&2
        echo "🔴 커밋 메시지가 규칙과 달라서 커밋을 막았습니다 (claude-work-harness, 지침서 09 커밋 메시지 규칙)." >&2
        echo "$out" | sed 's/^/   /' >&2
        echo "   제목을 고쳐 다시 커밋하세요." >&2
        exit 1
      fi
      echo "⚠️  커밋 메시지가 지침서 09 규칙과 다릅니다(경고만, 커밋은 진행됨)." >&2
      echo "$out" | sed 's/^/   /' >&2
    elif [[ -n "$out" ]]; then echo "$out" | sed 's/^/   /' >&2; fi ;;
  pre-push)
    remote="${1:-origin}"
    if [[ -x "$SCAN" ]]; then
      while read -r lref lsha rref rsha; do
        [[ -z "$lsha" || "$lsha" =~ ^0+$ ]] && continue          # branch deletion
        # new branch, or the remote's commit is unknown here (force push without fetching): every commit the remote lacks
        if [[ "$rsha" =~ ^0+$ ]] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then range=("$lsha" --not --remotes="$remote")
        else range=("$rsha..$lsha"); fi
        out=$("$SCAN" range . "${range[@]}") || block "푸시" "$out"
      done < "$stdin_file"
    fi
    SUBCHK="${SUBMODULE_CHECK:-$HOME/.claude/hooks/submodule-check.sh}"
    if [[ -x "$SUBCHK" ]] && ! "$SUBCHK" "$remote" < "$stdin_file"; then
      echo "   서브모듈 연결 문제로 푸시를 막았습니다 (claude-work-harness)." >&2
      exit 1
    fi ;;
esac

run_own "$@"
