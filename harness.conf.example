# claude-work-harness 설정
# 설치 스크립트가 이 파일을 ~/.claude/harness.conf 로 복사한다. 값을 고친 뒤 install.sh 를 다시 돌린다.
# bash 문법이다. 변수 이름은 영어로 둔다.

# 프로젝트 저장소들이 모여 있는 폴더. 작업 폴더(git 워크트리) 정리와 주간보고가 이 아래를 본다.
WORK_DIR="$HOME/Desktop/work"

# 노트 보관함(옵시디언 등). 주간보고는 여기의 work/<프로젝트>/<YYYY-MM-DD> 주간 (MM.DD~MM.DD)/ 노트를 근거로 읽는다.
NOTES_DIR="$HOME/Documents/노트"

# 업무 지침서 원본 폴더. 2026-11-16부터 이 저장소의 guides/ 를 원본으로 쓴다(세션이 읽고 고치는 곳, git 기록이 남음).
# 노트 보관함 폴더는 macOS 개인정보 보호 때문에 세션이 못 읽는 일이 잦아 원본으로 두지 않는다.
GUIDES_DIR="$HOME/claude-work-harness/guides"
# 노트 보관함(옵시디언)에 둘 지침서 사본 위치. 설치와 매일 예약 작업 때 sync-guides.sh 가 원본에서 한쪽으로 복사한다.
# 사본에서 고친 파일은 덮어쓰지 않고 알린다. 비워 두면 사본을 만들지 않는다.
NOTES_GUIDES_DIR="$NOTES_DIR/지침서"

# 고치거나 커밋하면 안 되는 저장소(예: 회사 공용 문서 저장소). 읽기는 허용한다. 절대 경로로 적는다.
READONLY_REPOS=()
# 예: READONLY_REPOS=("$HOME/Desktop/work/company-docs")

# 커밋, 푸시, 태그, 머지, PR을 하지 않는 저장소. 파일 수정은 허용한다. 절대 경로로 적는다.
NO_COMMIT_REPOS=()
# 예: NO_COMMIT_REPOS=("$HOME/Desktop/work/shared-relay")

# 목업 경로 검사에서 뺄 경로(저장소 기준 경로에 대한 정규식, 대소문자 무시). 비워 두면 예외 없음.
# 개발 서버와 시험이 함께 쓰는 공용 가상 응답(MSW 등)을 저장소에 두는 프로젝트에만 쓴다.
MOCK_ALLOW_PATHS_RE=''
# 예: MOCK_ALLOW_PATHS_RE='(^|/)src/mocks/'

# 보호 브랜치 규칙을 적용하지 않는 개인 저장소. 절대 경로로 적는다.
FREE_PUSH_REPOS=()

# 푸시와 머지에 매번 확인을 받는 보호 브랜치(정규식)
PROTECTED_BRANCHES_RE='^(dev|develop|main|master|prod|production|staging|stg)$'

# 주간보고 공통 양식 머리글
REPORT_DEPT="부서 이름"
REPORT_NAME="작성자 이름"

# 매일 예약 작업(작업 폴더 정리, 설정 저장, 요약 알림)을 도는 시각(0~23). 끄려면 빈 값으로 둔다.
DAILY_HOUR=9
# 한 세션이 동시에 돌리는 서브에이전트 수(기본 4명, 메모리 부담 때문에)
SUBAGENT_LIMIT=4
# 프로젝트마다 다르게 둘 때: ("<프로젝트 폴더>=<수>"). 그 폴더와 그 저장소의 작업 폴더에서 열린 세션에 적용된다
# SUBAGENT_LIMIT_BY_DIR=("$HOME/Desktop/work/큰프로젝트=10")

# 특정 프로젝트에서만 보호 브랜치 머지와 푸시를 확인 없이 허용할 때: ("<프로젝트 폴더>=<브랜치>[,<브랜치>]")
# 그 폴더 안 저장소, 서브모듈, 다른 곳에 만든 작업 폴더에 적용된다. main, prod, staging은 넣지 않는 것을 권한다
# FREE_BRANCHES_BY_REPO=("$HOME/Desktop/work/내프로젝트=dev")

# 개인 자료 검사(절대 경로, 노트 보관함 위치, 할 일 목록, 발신함 목록 커밋 막기)를 하지 않을 나 혼자 쓰는 저장소. 절대 경로로 적는다
PERSONAL_REPOS=()
# 예: PERSONAL_REPOS=("$HOME/work/personal-notes")
